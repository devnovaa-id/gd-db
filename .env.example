# Required
GDDB_ANON_KEY=your-shared-anon-key
GDDB_MASTER_KEY=run-npx-gddb-keys-generate
GDDB_DASHBOARD_PASSWORD=your-dashboard-password
GDDB_HANDLER_URL=https://your-deploy-url

# Token store (populated automatically after connecting Drive)
GDDB_TOKEN=

# Relay URL (optional, defaults to https://auth.gd-db.dev)
GDDB_RELAY_URL=https://auth.gd-db.dev

# Direct OAuth (optional — only if you want to use your own OAuth credentials instead of the relay)
# GDDB_CLIENT_ID=your-google-oauth-client-id
# GDDB_CLIENT_SECRET=your-google-oauth-client-secret
# GDDB_REDIRECT_URI=https://your-deploy-url/auth
